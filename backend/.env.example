ANTHROPIC_API_KEY=pega_aqui_tu_api_key_de_anthropic
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
# Opcional: DSN del proyecto de Sentry para monitoreo de errores en producción.
# Si se deja vacío, Sentry queda inerte (no envía nada). Se configura en Render.
SENTRY_DSN=

# Entorno. Si NO se declara, el backend se considera EN PRODUCCIÓN, y por eso
# se niega a arrancar cuando la persistencia SQLite no carga (ver
# backend/arranquePersistencia.js): arrancar sin poder guardar significa cobrar
# todo el día y perderlo en el siguiente reinicio.
#
# Para trabajar en la computadora sin compilar el módulo nativo better-sqlite3,
# declara development: el backend arranca igual, avisando a gritos, y NO guarda
# nada. Nunca pongas esto en Render.
# NODE_ENV=development
